{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Algorithm Atlas taxonomy",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "topics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "unspecified"
          ]
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "later": {
          "type": "boolean"
        },
        "reviewRequested": {
          "type": "boolean"
        },
        "complementary": {
          "type": "boolean"
        },
        "reviewInstruction": {
          "type": "string"
        },
        "sourceText": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "enabled",
            "intervalDays"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intervalDays": {
              "type": "number",
              "minimum": 1,
              "maximum": 3650
            },
            "lastReviewedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "role"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "primary",
                  "alternative"
                ]
              },
              "context": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "url"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}